POSTGRES_DB=review_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
DOCKER_REGISTRY_MIRRORS=https://docker.1ms.run,https://docker.1panel.live,https://docker.m.daocloud.io
DISABLE_DOCKER_MIRRORS=false
APT_MIRROR=http://mirrors.aliyun.com/debian
APT_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
POSTGRES_PORT=15432
REDIS_PORT=16379
API_PORT=8002
WEB_PORT=8001

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/review_ai
REDIS_URL=redis://127.0.0.1:16379
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/review_ai
APP_REDIS_URL=redis://redis:6379
USE_EXTERNAL_POSTGRES=false
USE_EXTERNAL_REDIS=false
EXTERNAL_DATABASE_URL=
EXTERNAL_REDIS_URL=

DEFAULT_ADMIN_EMAIL=admin
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_ADMIN_NAME=admin
DEFAULT_WORKSPACE_NAME=Admin Workspace
DEFAULT_WORKSPACE_SLUG=admin-workspace

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_MOCK_AI=true

# AI 分析吞吐配置。评论量很大时可按模型限流和服务器资源调高。
ANALYSIS_BATCH_SIZE=50
ANALYSIS_BATCH_CONCURRENCY=2
ANALYSIS_SINGLE_CONCURRENCY=6
ANALYSIS_WORKER_CONCURRENCY=2
ANALYSIS_REQUEST_TIMEOUT_MS=180000
ANALYSIS_BATCH_PAUSE_MS=0
ANALYSIS_SPLIT_BATCH_SIZE=10

AI_PROVIDER=openai
VOLC_ARK_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

SCRAPLING_ENABLED=true
SCRAPLING_CHROMIUM_EXECUTABLE=/usr/bin/chromium
SCRAPLING_PROXY=
SCRAPLING_CHANNELS=browser_intercept
SCRAPLING_DEFAULT_SOURCE=YouTube
SCRAPLING_DEFAULT_MAX_REVIEWS=200
SCRAPLING_TIMEOUT_SEC=180
SHOPEE_COOKIE=
